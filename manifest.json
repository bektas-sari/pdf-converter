{
  "manifest_version": 3,
  "name": "SuperPDF",
  "version": "1.0.0",
  "description": "All-in-one Chrome extension to view, edit, convert, sign, fill forms, and chat with PDFs.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "viewer/*",
        "editor/*",
        "form/*",
        "signature/*",
        "chat/*",
        "lib/pdfjs/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
